# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit real credentials.

PORT=5000

# Prisma connection string format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/queue_system"

# Any long random string works. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Free API key from https://console.groq.com (Groq is OpenAI-API-compatible
# and has a generous free tier -- good fit for a resume project).
# If using OpenAI instead, set AI_API_URL to https://api.openai.com/v1/chat/completions
# and AI_MODEL to a model you have access to, e.g. gpt-4o-mini.
AI_API_KEY=your_groq_or_openai_api_key
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.1-8b-instant
